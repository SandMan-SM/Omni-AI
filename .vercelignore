# Local test operator artifacts must not enter a deployment bundle.
scripts/.email-previews
scripts/.sitanim-payments*
scripts/sitanim-payments-live-*
scripts/sitanim-payments-operator.mjs
tests/*
# One exception, and it is deliberate. The content-lookup classifier's
# unit test runs in the BUILD CHAIN (`npm run test:content-lookup`), and a
# control that cannot run in the build is a control that does not hold — the
# PGRST116 mapping it pins broke once already, on the day it shipped. The
# file is a pure unit test: no credentials, no network, no operator
# artifacts. Everything else under tests/ stays out of the bundle.
!tests/content-lookup.test.ts
docs/private-email-previews/
**/runtime.env

# Local-only database administration scripts contain operator credentials and
# must never enter a Vercel deployment bundle.
scripts/migrate-auth.ts
scripts/setup-auth.ts
scripts/run-migrations.mjs

# Host-only AIS application verification; not application runtime.
scripts/check-ais-application-preflight.cjs
scripts/check-ais-application-e2e.cjs
scripts/run-ais-local-receiver.cjs
scripts/check-ais-production-replay.cjs
