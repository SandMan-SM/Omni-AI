# Global memory bump — every npm-run script inherits this, so dev / build /
# tsc / lint never hit the default 4GB Node heap ceiling. Tailwind JIT +
# the dynamic-import dashboard tree push past 4GB on cold start; 8GB gives
# plenty of headroom on a 16GB machine and stops the freeze-then-unfreeze
# pattern that surfaced in the dev server.
node-options=--max-old-space-size=8192

# Engine-strict — block npm install when Node major doesn't match
# package.json `engines.node`. This is what kept biting the local setup:
# Node 25 has subtle ESM / dependency-resolution behaviors that several
# packages here haven't been validated against. Pinning to 20.x LTS via
# .nvmrc + engines + this flag means `npm install` will refuse to proceed
# on the wrong major instead of installing a corrupted tree that crashes
# at runtime.
engine-strict=true

# Avoid auto-funding noise on every install
fund=false
audit-level=high
