{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/nightly-intel",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/weakness-scan",
      "schedule": "15 7 * * *"
    },
    {
      "path": "/api/cron/morning-digest",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/leadership-rotate",
      "schedule": "0 10 * * 1"
    }
  ]
}
