{
  "name": "omni-ai",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=3072' next dev --turbo",
    "dev:slow": "NODE_OPTIONS='--max-old-space-size=3072' next dev",
    "dev:clean": "rm -rf .next .turbo && NODE_OPTIONS='--max-old-space-size=3072' next dev --turbo",
    "dev:prod": "rm -rf .next-local && NEXT_DIST_DIR=.next-local next build && NEXT_DIST_DIR=.next-local next start",
    "preview": "git push origin HEAD:dev --force && echo '\\n→ Preview building at: https://omni-ai-git-dev-sandman-sms-projects.vercel.app\\n  (refresh in 60-90s for the new build)'",
    "preview:open": "open 'https://omni-ai-git-dev-sandman-sms-projects.vercel.app'",
    "build": "npm run audit:publish && npm run audit:rls && npm run audit:cron-auth && npm run audit:routes && npm run audit:route-probes && npm run audit:public-pii && npm run audit:sitemap && npm run audit:content-lookup && npm run audit:internal-surface && npm run test:internal-surface && npm run audit:credential-verification && npm run test:credential-verification && npm run audit:metadata-parity && npm run test:content-lookup && npm run audit:email-unsubscribe && npm run audit:image-aspect && npm run audit:federation-retirement && npm run test:federation-retirement && next build",
    "build:check": "node scripts/ensure-clean-worktree.mjs --phase before-build-check && npm run build:check:dirty && node scripts/ensure-clean-worktree.mjs --phase after-build-check",
    "build:check:dirty": "NEXT_DIST_DIR=.next-prod next build && rm -rf .next-prod",
    "start": "next start",
    "lint": "next lint",
    "check": "node scripts/ensure-clean-worktree.mjs --phase before-check && npm run check:dirty && node scripts/ensure-clean-worktree.mjs --phase after-check",
    "check:dirty": "tsc",
    "audit:mobile": "tsx scripts/audit-mobile-ui.ts",
    "audit:publish": "tsx scripts/audit-publish-state.ts",
    "audit:rls": "tsx scripts/audit-anon-rls.ts",
    "audit:rls-schema": "node scripts/audit-rls-schema-drift.mjs",
    "audit:pii-schema": "node scripts/audit-pii-schema-drift.mjs",
    "refresh:rls-ruleset": "node scripts/probe-anon-rls.mjs --write",
    "refresh:pii-ruleset": "node scripts/refresh-pii-ruleset.mjs",
    "audit:routes": "tsx scripts/audit-route-structure.ts",
    "audit:sitemap": "tsx scripts/audit-sitemap-parity.ts",
    "audit:public-pii": "node scripts/audit-public-pii.mjs",
    "audit:flash": "node scripts/audit-flash.mjs",
    "audit:deploy": "node scripts/audit-deploy-source-of-truth.mjs",
    "audit:cron-auth": "node scripts/audit-cron-auth.mjs",
    "audit:fleet-auth": "node scripts/audit-fleet-auth.mjs",
    "audit:fleet-rls": "node scripts/audit-fleet-rls.mjs",
    "audit:fleet-email-unsubscribe": "node scripts/audit-fleet-email-unsubscribe.mjs",
    "patch:fleet-cron-auth": "node scripts/patch-fleet-cron-auth.mjs",
    "patch:fleet-rls-ruleset": "node scripts/patch-fleet-rls-ruleset.mjs",
    "patch:fleet-public-pii": "node scripts/patch-fleet-public-pii.mjs",
    "audit": "npm run audit:mobile && npm run audit:publish && npm run audit:rls && npm run audit:cron-auth && npm run audit:routes && npm run audit:route-probes && npm run audit:public-pii && npm run audit:sitemap && npm run audit:content-lookup && npm run audit:internal-surface && npm run audit:credential-verification && npm run audit:metadata-parity && npm run audit:email-unsubscribe && npm run audit:image-aspect && npm run audit:federation-retirement",
    "worktree:clean": "node scripts/ensure-clean-worktree.mjs",
    "audit:env-drift": "tsx scripts/audit-env-drift.ts",
    "audit:pre-push": "node scripts/audit-pre-push.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "hooks:check": "node scripts/install-git-hooks.mjs --check",
    "audit:route-probes": "tsx scripts/audit-route-probes.ts",
    "audit:email-unsubscribe": "node scripts/audit-email-unsubscribe.mjs",
    "audit:image-aspect": "node scripts/audit-image-aspect.mjs",
    "audit:content-lookup": "node scripts/audit-content-lookup.mjs",
    "test:content-lookup": "tsx --test tests/content-lookup.test.ts",
    "audit:fleet-content-lookup": "node scripts/audit-fleet-content-lookup.mjs",
    "audit:fleet-internal-surface": "node scripts/audit-fleet-internal-surface.mjs",
    "patch:fleet-internal-surface": "node scripts/patch-fleet-internal-surface.mjs",
    "patch:fleet-content-lookup": "node scripts/patch-fleet-content-lookup.mjs",
    "audit:fleet-public-pii": "node scripts/audit-fleet-public-pii.mjs",
    "audit:internal-surface": "node scripts/audit-internal-surface.mjs",
    "audit:federation-retirement": "node scripts/audit-federation-retirement.mjs",
    "test:federation-retirement": "node --test tests/federation-retirement.test.cjs",
    "test:internal-surface": "tsx --test tests/internal-surface.test.ts",
    "audit:metadata-parity": "node scripts/audit-metadata-parity.mjs",
    "audit:credential-verification": "node scripts/audit-credential-verification.mjs",
    "test:credential-verification": "tsx --test tests/credential-verification.test.ts",
    "audit:fleet-credential-verification": "node scripts/audit-fleet-credential-verification.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-select": "^2.2.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.67.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.60.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/oidc": "^4.0.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.13.1",
    "lucide-react": "^0.460.0",
    "next": "^14.2.21",
    "next-themes": "^0.4.4",
    "pg": "8.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "recharts": "^2.15.2",
    "resend": "^6.10.0",
    "sharp": "0.35.5",
    "stripe": "^21.0.1",
    "stripe-sitanim": "npm:stripe@^22.6.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.2.5",
    "zod": "^3.24.2",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.27",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.8",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "5.6.3"
  }
}
