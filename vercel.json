{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/nightly-intel",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/morning-digest",
      "schedule": "0 10 * * *"
    }
  ]
}
